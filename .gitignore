# --- R / RStudio -------------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Personal settings and secrets. Never commit these.
.Renviron
.Renviron.*
*.pem
*.key

# --- Positron / VS Code -----------------------------------------------------
# Shared settings live in .vscode/settings.json; everything else is personal.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Quarto -----------------------------------------------------------------
# Rendered output is rebuilt by GitHub Actions, so it never goes in Git.
/.quarto/
/_site/
*_files/
*.quarto_ipynb
*.html
*.pdf
!assets/**/*.html

# --- Data -------------------------------------------------------------------
# The database is regenerated from data-raw/make-synthetic.R.
data/*.duckdb
data/*.duckdb.wal
# Excel downloads are written during render.
/downloads/
# Exercise 4 adds a rule for ad hoc extracts here.

# --- OS clutter -------------------------------------------------------------
.DS_Store
Thumbs.db
